{
  "name": "jot",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first notebook and AI assistant for Windows",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "verify:llm": "vitest run --config vitest.llm.config.ts",
    "test:packed": "playwright test --config playwright.packed.config.ts",
    "app:dir": "electron-vite build && electron-builder --win --dir",
    "app:dist": "electron-vite build && electron-builder --win",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "licenses:generate": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "source:export": "node scripts/export-source.mjs",
    "release:artifacts": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "test:release": "vitest run tests/unit/settings.test.ts tests/unit/secrets.test.ts tests/unit/content-scope.test.ts tests/unit/library-pins.test.ts tests/unit/pi.test.ts tests/unit/u6-productivity.test.ts tests/unit/release.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "better-sqlite3": "^13.1.1",
    "chokidar": "^6.0.0",
    "decimal.js": "10.6.0",
    "js-yaml": "4",
    "typebox": "1.3.27",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "author": "Jot contributors",
  "build": {
    "appId": "local.jot.app",
    "productName": "Jot",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/plugins{,/**/*}",
      "!resources/app-extensions{,/**/*}",
      "package.json",
      "!**/node_modules/better-sqlite3/{deps,src,build}/**",
      "!**/node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}-*",
      "!**/node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!**/*.{md,map,ts,tsbuildinfo}",
      "!**/{test,tests,docs,examples}/**"
    ],
    "extraResources": [
      {
        "from": "resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/app-extensions",
        "to": "app-extensions",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jot"
    },
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "filter": [
          "**/*"
        ],
        "to": "licenses",
        "from": "../licenses"
      }
    ]
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suncodes/jot.git"
  },
  "homepage": "https://github.com/suncodes/jot#readme",
  "bugs": {
    "url": "https://github.com/suncodes/jot/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.15.4"
}
