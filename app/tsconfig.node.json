{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "composite": false
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/llm/**/*.ts",
    "tests/helpers/**/*.ts",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.llm.config.ts",
    "tests/perf/**/*.ts",
    "vitest.perf.config.ts"
  ]
}
